# Analysis runtime config for scripts/analysis/run_all_analysis.sh

# Scope
ANALYSIS_SUBSET=val
ANALYSIS_MODELS=EDL,ensemble,mcdropout

# Leave empty to process all files, set to 1/10/... for quick smoke
ANALYSIS_MAX_FILES=

# Analysis knobs
ANALYSIS_RETENTION_STEPS=50
ANALYSIS_RETENTION_TARGET=0.9
ANALYSIS_PATCH_SIZE=3
ANALYSIS_RETENTION_GROUP=all

# Optional plotting switches (1=run, 0=skip)
ANALYSIS_RUN_RETENTION_PLOT=1
ANALYSIS_RUN_EPI_FP_FN_PLOT=1

# Paths
ANALYSIS_DATA_ROOT=/home/NAS/homes/cjchen-10025/data/worldfloods_v2/data
ANALYSIS_PRED_ROOT=/home/NAS/homes/cjchen-10025/flood-uncertainty/artifacts/results/val_test_inference
ANALYSIS_OUTPUT_ROOT=/home/NAS/homes/cjchen-10025/flood-uncertainty/artifacts/results/analysis_S2
ANALYSIS_FIGURE_ROOT=/home/NAS/homes/cjchen-10025/flood-uncertainty/artifacts/results/figures
ANALYSIS_COMPARE_OUTPUT_ROOT=/home/NAS/homes/cjchen-10025/flood-uncertainty/artifacts/results/analysis_S2/compare
ANALYSIS_LOG_DIR=/home/NAS/homes/cjchen-10025/flood-uncertainty/artifacts/results/analysis_S2/logs
